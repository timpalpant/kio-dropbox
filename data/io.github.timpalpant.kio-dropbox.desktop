[Desktop Entry]
Type=Application
Name=Dropbox Account Setup
GenericName=Dropbox Account Setup
Comment=Link a Dropbox account so it can be browsed in Dolphin
Exec=kio-dropbox-auth
Icon=io.github.timpalpant.kio-dropbox
Categories=Qt;KDE;Settings;
Keywords=dropbox;cloud;storage;account;kio;dolphin;
Terminal=false
StartupNotify=true
X-KDE-StartupNotify=true
